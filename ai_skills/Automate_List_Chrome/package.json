{
  "name": "automated-list-chrome",
  "version": "1.0.0",
  "description": "Douyin Shop Automated Listing App in Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.workbuddy.automatedlisting",
    "productName": "抖店自动化上架系统",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "axios": "^1.6.8",
    "md5": "^2.3.0",
    "playwright-core": "^1.42.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^26.8.1"
  }
}
