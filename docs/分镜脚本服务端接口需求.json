  "requests": [
    {
      "name": "分镜脚本-保存",
      "path": "/api/storyboard/scripts",
      "method": "POST",
      "requirement": "保存分镜脚本到服务端（按客户端机器码隔离，同一 topic 重复保存视为更新），保存成功返回脚本 id 与版本号；「一键成片 → 脚本成片」可直接读取该列表。数据字段沿用客户端现有 JSON：topic/ratio/total_duration/shot_count/shots/saved_at，shots 元素 {index, shot_type, visual, audio, sfx, duration}，与 storyboard_montage 成片任务 params.shots 一致。",
      "params": [
        {
          "name": "topic",
          "type": "string",
          "required": true,
          "desc": "选题名称"
        },
        {
          "name": "ratio",
          "type": "string",
          "required": true,
          "desc": "画幅比例，如 9:16 / 16:9"
        },
        {
          "name": "total_duration",
          "type": "float",
          "required": true,
          "desc": "总时长（秒）"
        },
        {
          "name": "shot_count",
          "type": "int",
          "required": true,
          "desc": "镜头数量"
        },
        {
          "name": "shots",
          "type": "list[object]",
          "required": true,
          "desc": "镜头数组 [{index, shot_type, visual, audio, sfx, duration}]"
        },
        {
          "name": "saved_at",
          "type": "string",
          "required": false,
          "desc": "保存时间 ISO8601，缺省用服务端时间"
        }
      ],
      "response": "{\"id\": \"script_xxx\", \"version\": 2, \"saved_at\": \"2026-08-01T10:00:00+08:00\"}",
      "notes": "机器码隔离：服务端从请求识别 device_id（或客户端显式传参）；同一 topic+机器码重复提交覆盖更新不新增。"
    },
    {
      "name": "分镜脚本-列表",
      "path": "/api/storyboard/scripts",
