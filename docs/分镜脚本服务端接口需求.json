        {
          "name": "page",
          "type": "int",
          "required": false,
          "desc": "页码，从 1 开始"
        },
        {
          "name": "page_size",
          "type": "int",
          "required": false,
          "desc": "每页数量，默认 20"
        }
      ],
      "response": "{\"items\": [{\"id\": \"script_xxx\", \"topic\": \"GPW宣传片\", \"ratio\": \"9:16\", \"shot_count\": 8, \"updated_at\": \"2026-08-01T10:00:00+08:00\"}], \"total\": 12}",
      "notes": "列表项只返回摘要，详情走 GET /api/storyboard/scripts/{id}。"
